# LLM: openai_compatible, deepseek, or vllm
LLM_PROVIDER=openai_compatible
LLM_MODEL=your-model-name
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-with-your-key

# Neo4j local structured retrieval
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-password
NEO4J_DATABASE=neo4j

# Official Tavily remote MCP server: https://mcp.tavily.com/mcp/
TAVILY_API_KEY=tvly-replace-with-your-key
AGENT_CACHE_PATH=.cache/knowledge_agent.db
